{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd server && npm install && npm run build && cp -r data dist/data"
  },
  "deploy": {
    "startCommand": "cd server && node dist/src/index.js",
    "restartPolicyType": "ON_FAILURE"
  }
}
